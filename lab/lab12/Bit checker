#include <stdio.h>
int main() {
 
 unsigned char num;
 
 printf("\nEnter any 8 bit number (0-255) : ");
 scanf("%hhu",&num);
 
 printf("\nThe original number is  : %u",num);
 
 if(num & (1<<3)){
     printf("\nThe fourth bit is on.");
     num=num & ~(1<<3);
 }
 else
 printf("\nThe fourth bit is off.");
 
 if(num & (1<<6)){
     printf("\nThe seventh bit is on.");
     num=num & (1<<6);
 }
 else
 printf("\nThe seventh bit is off");
 
 printf("\nThe number after turning off the 4th and 7th bits is  : %u",num);

    return 0;
}
