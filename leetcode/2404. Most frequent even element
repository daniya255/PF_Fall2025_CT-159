int mostFrequentEven(int* nums, int numsSize) {
    int freq[100001] = {0};  
    int maxFreq = 0;
    int answer = -1;

    for (int i = 0; i < numsSize; i++) {
        if (nums[i] % 2 == 0) {        
            freq[nums[i]]++;

            if (freq[nums[i]] > maxFreq) {
                maxFreq = freq[nums[i]];
                answer = nums[i];
            }
            else if (freq[nums[i]] == maxFreq && nums[i] < answer) {
                answer = nums[i];
            }
        }
    }

    return answer;
}
