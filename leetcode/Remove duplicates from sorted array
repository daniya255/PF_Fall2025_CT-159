int removeDuplicates(int* nums, int numsSize) {

    if(numsSize < 1 || numsSize > 30000) 
    return 0;

    for(int k = 0; k < numsSize; k++){
        if(nums[k] < -10000 || nums[k] > 10000) 
        return 0;
    }

    int i = 0; 

    for(int j = 1; j < numsSize; j++){
        if(nums[j] != nums[i]){
            i++;
            nums[i] = nums[j];
        }
    }

    return i + 1; 
}

    
