int strStr(char* haystack, char* needle) {

    int hayLen=strlen(haystack);
    int needleLen=strlen(needle);

    if(hayLen<1 || hayLen>10000)
    return 0;

    if(needleLen<0 || needleLen>1000)
    return 0;

    if(needleLen==0)
    return 0;


    for(int i=0;haystack[i]!='\0';i++){
     if(haystack[i]<'a' || haystack[i]>'z')
       return 0;
    }

    for(int i=0;needle[i]!='\0';i++){
     if(needle[i]<'a' || needle[i]>'z')
       return 0;
    }


    for(int i=0;haystack[i]!='\0';i++){
        int j=0;
        while(needle[j]!='\0' && haystack[i+j]!='\0' && haystack[i+j]==needle[j]){
            j++;
        }

        if(j==needleLen)
        return i;
    }

    return -1;

        }
