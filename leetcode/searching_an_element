

bool searchMatrix(int** matrix, int matrixSize, int *matrixColSize, int target){
 
    if(*matrixColSize<1 || matrixSize>300){
        return 0;
    }

    
for(int i=0;i<matrixSize;i++){
        for(int j=0;j<*matrixColSize;j++){
            if(target==matrix[i][j]){
                
                return true;
                break;
            }
            
        }
    }
return false;



}
