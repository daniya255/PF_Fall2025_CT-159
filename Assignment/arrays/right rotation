#include<stdio.h>
void reverse(int arr[],int si,int ei){
    int i=si,j=ei;
    
        while(i<j){
            int temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
            
            i++;
            j--;
        }
        
}
int main(){
    int k,size;
    
    printf("\nEnter the size of the array : ");
    scanf("%d",&size);
    
    int arr[size];
    
    //inputting array
    for(int i=0;i<size;i++){
        printf("\nEnter element at index %d : ",i);
        scanf("%d",&arr[i]);
    }
    
    printf("\nEnter the steps to which you want to rotate your array : ");
    scanf("%d",&k);
    
    k%=size;
    
    printf("\nThe array before rotation is ..");
    for(int i=0;i<size;i++){
        printf("%d ",arr[i]);
    }
    
    reverse(arr,0,size-1);
    reverse(arr,0,k-1);
    reverse(arr,k,size-1);
    
    //printing the array
    printf("\nThe array after rotation is ..");
    for(int i=0;i<size;i++){
        printf("%d ",arr[i]);
    }
}
