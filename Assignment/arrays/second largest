#include<stdio.h>
int main(){
    int size;
    
    printf("\nEnter the size of the array : ");
    scanf("%d",&size);
    
    int arr[size],max=0,smax=0;
    
    //inputting array
    for(int i=0;i<size;i++){
        printf("\nEnter element at index %d : ",i);
        scanf("%d",&arr[i]);
    }
    
    for(int i=0;i<size;i++){
        printf("%d ",arr[i]);

    }
    
    for(int i=0;i<size;i++){
        if(max<arr[i]){
            max=arr[i];
    }
    }
    
    for(int i=0;i<size;i++){
        if(smax<arr[i] && arr[i]!=max)
        smax=arr[i];
    }
    
    printf("\nThe second largest element is : %d",smax);
    
    return 0;
    
    
    
}
